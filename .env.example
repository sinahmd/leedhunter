# LeedHunter Configuration
# Copy this file to .env and update with your settings

# Application Settings
LEEDHUNTER_APP_NAME=LeedHunter
LEEDHUNTER_VERSION=0.1.0
LEEDHUNTER_DEBUG=false
LEEDHUNTER_LOG_LEVEL=INFO

# PostgreSQL Database
LEEDHUNTER_DB_HOST=localhost
LEEDHUNTER_DB_PORT=5432
LEEDHUNTER_DB_USER=leedhunter
LEEDHUNTER_DB_PASSWORD=leedhunter
LEEDHUNTER_DB_NAME=leedhunter

# Redis
LEEDHUNTER_REDIS_HOST=localhost
LEEDHUNTER_REDIS_PORT=6379
LEEDHUNTER_REDIS_PASSWORD=
LEEDHUNTER_REDIS_DB=0

# LLM Provider (Optional - set enabled=true to use)
# LLM is completely optional - all features work without it
LEEDHUNTER_LLM_ENABLED=false
LEEDHUNTER_LLM_PROVIDER=anthropic
LEEDHUNTER_LLM_API_KEY=
LEEDHUNTER_LLM_BASE_URL=
LEEDHUNTER_LLM_MODEL=claude-3-sonnet-20240229
LEEDHUNTER_LLM_MAX_TOKENS=4096
LEEDHUNTER_LLM_TEMPERATURE=0.2
LEEDHUNTER_LLM_TIMEOUT_SECONDS=60
LEEDHUNTER_LLM_MAX_CALLS_PER_RESEARCH=10
LEEDHUNTER_LLM_MAX_COST_PER_RESEARCH=

# Supported providers: anthropic, openai, openai_compatible
# Install extras:
#   pip install leedhunter[llm-anthropic]
#   pip install leedhunter[llm-openai]
#   pip install leedhunter[llm-all]

# Search Settings
LEEDHUNTER_SEARCH_DEFAULT_PROVIDER=fixture
LEEDHUNTER_SEARCH_MAX_RESULTS_PER_QUERY=100
LEEDHUNTER_SEARCH_TIMEOUT_SECONDS=30.0

# Tavily Search API (optional - for real web search)
# Get your API key from: https://tavily.com/
# Free tier: 1,000 searches/month
LEEDHUNTER_SEARCH_TAVILY_API_KEY=

# Brave Search API (optional - for real web search)
# Get your API key from: https://brave.com/search/api/
LEEDHUNTER_SEARCH_BRAVE_API_KEY=

# Research Job Limits
LEEDHUNTER_RESEARCH_MAX_QUERIES=100
LEEDHUNTER_RESEARCH_MAX_CANDIDATES=1000
LEEDHUNTER_RESEARCH_MAX_PAGES_PER_ENTITY=10
LEEDHUNTER_RESEARCH_MAX_RUNTIME_SECONDS=3600
LEEDHUNTER_RESEARCH_MAX_LLM_CALLS=100

# sandbox settings
LEEDHUNTER_SANDBOX_MAX_MEMORY_MB=1024
LEEDHUNTER_SANDBOX_MAX_CPU_PERCENT=75.0
LEEDHUNTER_SANDBOX_HEADLESS=true
LEEDHUNTER_SANDBOX_TIMEOUT=60